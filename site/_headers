/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# The asset filenames are stable (core.css, themes.css, theme.js) rather than
# content-hashed, so they must NOT be cached immutably: a returning visitor
# would keep the old stylesheet until it expired. Revalidation gives a 304 on
# every unchanged request — nearly as fast, and always correct.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
